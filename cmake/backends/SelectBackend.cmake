set(RTYPE_RENDER_BACKEND "NULL" CACHE STRING "Backend de rendu : SFML ou NULL")
set_property(CACHE RTYPE_RENDER_BACKEND PROPERTY STRINGS NULL SFML)

set(_rtype_known_backends NULL SFML)
if(NOT RTYPE_RENDER_BACKEND IN_LIST _rtype_known_backends)
  message(FATAL_ERROR "RTYPE_RENDER_BACKEND='${RTYPE_RENDER_BACKEND}' invalide (attendu : NULL ou SFML)")
endif()
find_package(SFML 3 CONFIG QUIET NO_CMAKE_SYSTEM_PATH NO_SYSTEM_ENVIRONMENT_PATH NO_CMAKE_PACKAGE_REGISTRY NO_CMAKE_SYSTEM_PACKAGE_REGISTRY)
if(SFML_FOUND AND NOT TARGET sfml::sfml)
  set(SFML_FOUND FALSE)
endif()
if(RTYPE_RENDER_BACKEND STREQUAL "SFML" AND NOT SFML_FOUND)
  message(FATAL_ERROR "RTYPE_RENDER_BACKEND=SFML demande SFML 3 fournie par Conan : lancer conan install avec -o sfml=True")
endif()
message(STATUS "Backend de rendu : ${RTYPE_RENDER_BACKEND}")
